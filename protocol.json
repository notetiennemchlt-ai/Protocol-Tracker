      "name": "Circadian Anchoring",
      "items": [
        {
          "text": "Phase 1 (0-8 hours after waking)",
          "status": "running",
          "subitems": [
            "Morning sunlight",
            "Maximize light exposure while working",
            "Do deep focus work in this phase",
            "Caffeine and cold exposure done in this phase"
          ]
        },
        {
          "text": "Phase 2 (8-16 hours after waking)",
          "status": "running",
          "subitems": [
            "Do easier tasks during this phase of the day if possible",
            "Begin dimming lights as the day goes on"
          ]
        },
        {
          "text": "Phase 3 (16-24 hours after waking)",
          "status": "running",
          "subitems": [
            "Ideally, sleep during this phase",
            "If you choose to work instead, work in an environment as dimly lit as possible while still being able to do work"
          ]
        }
      ]
